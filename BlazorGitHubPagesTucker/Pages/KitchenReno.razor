@page "/kitchenreno"
@inject IJSRuntime JsRuntime

<PageTitle>Kitchen Reno</PageTitle>

<h1>Redirecting...</h1>
<p>If a new tab does not open, use this link: <a href="https://photos.app.goo.gl/J9F8DQ2NDrxoEPR4A" target="_blank" rel="noopener noreferrer">Kitchen Reno 2025</a>.</p>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await JsRuntime.InvokeVoidAsync("open", "https://photos.app.goo.gl/J9F8DQ2NDrxoEPR4A", "_blank", "noopener,noreferrer");
    }
}
